# Copia este fichero a wrangler.toml (que esta en .gitignore) y edita el nombre.
name = "tweaktools-whatsapp"
main = "src/index.js"
compatibility_date = "2026-01-01"

# Opcional pero recomendado: aunque te roben el token, solo se puede escribir a
# estos numeros. Separados por coma, solo digitos, con prefijo de pais.
# [vars]
# ALLOWED_NUMBERS = "34600111222"

# Los tres secretos NO van aqui. Se suben con:
#   npx wrangler secret put TWEAKTOOLS_TOKEN
#   npx wrangler secret put META_TOKEN
#   npx wrangler secret put WABA_PHONE_ID
